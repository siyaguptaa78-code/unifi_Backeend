# Server Port & URL
PORT=5000
NODE_ENV=production
APP_URL=https://unificafe.vercel.app

# MongoDB Connection String (Atlas Replica Set for production, or local embedded)
# Atlas format: mongodb+srv://anuraagmishra21_db_user:<PASSWORD>@cluster0.m0h122z.mongodb.net/unicafe?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/unicafe?replicaSet=rs0

# JWT Auth Secret (Must be at least 32 characters)
JWT_SECRET=super-secret-production-quality-unicafe-jwt-signing-key-32chars

# Payment Gateway Configuration (Test or Live)
PAYMENT_MODE=demo
RAZORPAY_KEY_ID=rzp_test_YourTestKey12345
RAZORPAY_KEY_SECRET=YourRazorpaySecretKey12345
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretKey12345

# Mock Services
EMAIL_PROVIDER=mock
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
DISABLE_RATE_LIMIT=false

